# Build the backend first: ./mvnw -B verify (exports target/openapi/openapi.json).
FROM node:24.19.0-alpine AS build
WORKDIR /app
COPY src/main/webui/package.json src/main/webui/package-lock.json ./
RUN npm ci
COPY src/main/webui/ ./
COPY target/openapi/openapi.json ./openapi.json
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.30.6-alpine
COPY src/main/docker/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
USER 101
EXPOSE 8080
